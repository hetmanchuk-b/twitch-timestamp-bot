# ========================================================
# Twitch Timestamp Bot Configuration
# ========================================================

# Twitch User OAuth token
# Can be generated at https://twitchtokengenerator.com/
# Required scopes: chat:read, chat:edit (and moderator:manage:chat_messages if deleting commands is desired)
TWITCH_TOKEN=oauth:your_oauth_token_here

# Twitch Application Client ID
# Can be retrieved from https://twitchtokengenerator.com/ or https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your_client_id_here

# Target Twitch channel name where the stream is hosted (lowercase, no @)
TWITCH_CHANNEL=your_channel_name

# Prefix for chat commands (default: !)
BOT_PREFIX=!

# Whether to delete the !time command message from chat after processing
# Note: Bot must have moderator status on the channel
DELETE_COMMAND_MESSAGE=false

# Directory to save timestamp files
OUTPUT_DIR=timestamps

# ========================================================
# Web Server & Hosting (Render.com / Cloud)
# ========================================================
# Port for the web server (Render sets PORT automatically)
PORT=8080
HOST=0.0.0.0

# Public URL of your deployed bot (e.g. https://your-app.onrender.com)
# Used for generating clickable links in Discord notifications
PUBLIC_BASE_URL=http://localhost:8080

# Secret API key for OBS hotkey integration (optional, protect against unauthorized marks)
# Set any secret password here, e.g. my_secret_obs_key_123
API_KEY=your_secret_obs_key_here

# ========================================================
# Discord Webhook Notification
# ========================================================
# Optional: Discord Webhook URL to receive real-time timestamp embeds and end-of-stream summaries
# Leave empty if you do not wish to use Discord notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
